rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validClass(v) { return v in ['archer','warrior','guardian','mage','assassin','lancer']; }
    function validGender(v) { return v in ['m','f']; }
    function validContinent(v) { return v in ['aetherion','frostheim','drakthar','sylvaris','dunemara','thalassara','umbraxis']; }
    function validGameName(v) { return v is string && v.matches('^[A-Za-z0-9]{5,13}$'); }
    function validNormalizedName(v) { return v is string && v.matches('^[a-z0-9]{5,13}$'); }
    function authEmailMatches(v) { return !(('email' in request.auth.token)) || v == request.auth.token.email; }

    function initialUser(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'uid','firstName','lastName','email','birthdate','characterCreated','characterDraft','character',
        'level','experience','currentContinent','currencies','equipment','inventory','questProgress',
        'dungeonProgress','tournamentStats','guildId','appearance','createdAt','lastLoginAt','profileVersion'
      ])
      && d.uid == uid
      && d.firstName is string && d.firstName.size() <= 40
      && d.lastName is string && d.lastName.size() <= 40
      && d.email is string && authEmailMatches(d.email)
      && (d.birthdate == null || d.birthdate is string)
      && d.characterCreated == false
      && d.characterDraft is map && d.characterDraft.keys().size() == 0
      && d.character == null
      && d.level == 1 && d.experience == 0 && d.currentContinent == null
      && d.currencies is map && d.currencies.keys().hasOnly(['gold','gems'])
      && d.currencies.gold == 60 && d.currencies.gems == 0
      && d.equipment is map
      && d.equipment.keys().hasOnly(['weaponId','helmet','chest','leggings','boots','wings','necklace','earrings','bracelet','ring'])
      && d.equipment.weaponId == null && d.equipment.helmet == null && d.equipment.chest == null
      && d.equipment.leggings == null && d.equipment.boots == null && d.equipment.wings == null
      && d.equipment.necklace == null && d.equipment.earrings == null && d.equipment.bracelet == null && d.equipment.ring == null
      && d.inventory is map && d.inventory.keys().hasOnly(['items','armors','weapons','accessories','bundleChest'])
      && d.inventory.items is map && d.inventory.items.keys().hasOnly(['potion']) && d.inventory.items.potion == 2
      && d.inventory.armors is map && d.inventory.armors.keys().size() == 0
      && d.inventory.weapons is map && d.inventory.weapons.keys().size() == 0
      && d.inventory.accessories is map && d.inventory.accessories.keys().size() == 0
      && d.inventory.bundleChest is map && d.inventory.bundleChest.keys().size() == 0
      && d.questProgress is map
      && d.dungeonProgress is map && d.dungeonProgress.highestFloor == 0
      && d.dungeonProgress.completedFloors is list && d.dungeonProgress.completedFloors.size() == 0
      && d.tournamentStats is map && d.tournamentStats.wins == 0 && d.tournamentStats.losses == 0
      && d.tournamentStats.ties == 0 && d.tournamentStats.rank == 0
      && d.guildId == null && d.appearance is map && d.profileVersion == 1
      && d.createdAt is timestamp && d.lastLoginAt is timestamp;
    }

    function validDraft() {
      let d = request.resource.data.characterDraft;
      return d is map
        && d.keys().hasOnly(['classId','gender'])
        && (!('classId' in d) || validClass(d.classId))
        && (!('gender' in d) || validGender(d.gender));
    }

    function completingCharacter(uid) {
      let d = request.resource.data;
      let c = d.character;
      let starter = 'w_' + c.classId + '_0';
      return resource.data.characterCreated == false
        && d.characterCreated == true
        && d.diff(resource.data).affectedKeys().hasOnly([
          'characterCreated','characterDraft','character','level','experience','currentContinent',
          'currencies','equipment','inventory','lastLoginAt'
        ])
        && c is map && c.keys().hasOnly(['classId','gender','inGameName','normalizedName','createdAt'])
        && validClass(c.classId) && validGender(c.gender)
        && validGameName(c.inGameName) && validNormalizedName(c.normalizedName)
        && c.normalizedName == c.inGameName.lower()
        && c.createdAt is timestamp
        && d.characterDraft is map && d.characterDraft.keys().size() == 0
        && d.level == 1 && d.experience == 0 && d.currentContinent == null
        && d.currencies == resource.data.currencies
        && d.equipment.weaponId == starter
        && d.equipment.helmet == null && d.equipment.chest == null && d.equipment.leggings == null
        && d.equipment.boots == null && d.equipment.wings == null && d.equipment.necklace == null
        && d.equipment.earrings == null && d.equipment.bracelet == null && d.equipment.ring == null
        && d.inventory.items == resource.data.inventory.items
        && d.inventory.armors == resource.data.inventory.armors
        && d.inventory.accessories == resource.data.inventory.accessories
        && d.inventory.bundleChest == resource.data.inventory.bundleChest
        && d.inventory.weapons is map && d.inventory.weapons.keys().size() == 1
        && d.inventory.weapons[starter] == 1
        && existsAfter(/databases/$(database)/documents/playerNames/$(c.normalizedName))
        && getAfter(/databases/$(database)/documents/playerNames/$(c.normalizedName)).data.uid == uid;
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && initialUser(uid);
      allow update: if owner(uid) && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt','email'])
          && request.resource.data.email is string
          && authEmailMatches(request.resource.data.email)
        )
        ||
        (
          resource.data.characterCreated == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['characterDraft'])
          && validDraft()
        )
        || completingCharacter(uid)
        ||
        (
          resource.data.characterCreated == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentContinent','lastLoginAt'])
          && validContinent(request.resource.data.currentContinent)
        )
      );
      allow delete: if false;
    }

    match /playerNames/{normalizedName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validNormalizedName(normalizedName)
        && request.resource.data.keys().hasOnly(['uid','displayName','normalizedName','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validGameName(request.resource.data.displayName)
        && request.resource.data.normalizedName == normalizedName
        && normalizedName == request.resource.data.displayName.lower()
        && request.resource.data.createdAt is timestamp
        && !exists(/databases/$(database)/documents/playerNames/$(normalizedName))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.characterCreated == true
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.character.normalizedName == normalizedName;
      allow update, delete: if false;
    }

    match /guilds/{guildId} {
      allow read: if signedIn();
      allow write: if false;
      match /members/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
    match /guildNames/{id} { allow read: if signedIn(); allow write: if false; }
    match /guildSigns/{id} { allow read: if signedIn(); allow write: if false; }

    match /dailyQuestRuns/{runId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /dungeonRuns/{runId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /tournamentMatches/{matchId} {
      allow read: if signedIn() && (
        resource.data.playerUid == request.auth.uid || resource.data.opponentUid == request.auth.uid
      );
      allow write: if false;
    }

    match /itemDefinitions/{itemId} { allow read: if signedIn(); allow write: if false; }
    match /leaderboards/{id} { allow read: if signedIn(); allow write: if false; }
    match /worldAnnouncements/{id} { allow read: if signedIn(); allow write: if false; }
    match /adminAuditLogs/{id} { allow read, write: if false; }

    match /playerInventories/{uid} { allow read: if owner(uid); allow write: if false; }
    match /playerEquipment/{uid} { allow read: if owner(uid); allow write: if false; }
    match /playerProgress/{uid} { allow read: if owner(uid); allow write: if false; }
    match /playerQuests/{uid} { allow read: if owner(uid); allow write: if false; }
    match /playerDungeonProgress/{uid} { allow read: if owner(uid); allow write: if false; }
    match /playerTournamentStats/{uid} { allow read: if owner(uid); allow write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
